{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Active Target",
      "type": "cppdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": [
        "16",
        "1"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "preLaunchTask": "CMake Build",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Source custom .gdbinit",
          "text": "-x ${userHome}/.gdbinit",
          "ignoreFailures": true
        }
      ]
    }
  ]
}